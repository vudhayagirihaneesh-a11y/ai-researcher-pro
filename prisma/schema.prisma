generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model KnowledgeChunk {
  id        Int      @id @default(autoincrement())
  docId     String   @unique
  domain    String
  title     String
  content   String
  keywords  String   @default("")
  source    String   @default("")
  origin    String   @default("seed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@index([origin])
}

model ResearchSession {
  id          String        @id @default(cuid())
  topic       String
  kind        String        @default("research")
  mode        String        @default("essay")
  depth       String        @default("fast")
  status      String        @default("running")
  title       String?
  markdown    String?
  sourcesJson String?
  statsJson   String?
  notes       String?
  wordCount   Int           @default(0)
  imageCount  Int           @default(0)
  error       String?
  browserId   String?       @default("anonymous")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  images      EssayImage[]
}

model EssayImage {
  id        String          @id @default(cuid())
  sessionId String
  fileName  String
  url       String
  remoteUrl String?
  caption   String
  credit    String          @default("AI-generated")
  prompt    String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime        @default(now())
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
